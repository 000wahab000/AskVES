# ──────────────────────────────────────────────
#  AskVES – Environment Variables Example
#  Copy this file to `.env` and fill in values.
# ──────────────────────────────────────────────

# Google Gemini API Key
# Get it free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Keys (comma-separated list of 3 keys for round-robin load balancing)
# Get free keys at: https://console.groq.com/keys
# Create 3 separate keys and paste them here separated by commas (no spaces)
GROQ_API_KEYS=key1,key2,key3

# Supabase Project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
# https://supabase.com/dashboard
SUPABASE_URL=

# Supabase Anon/Service Key
# Found in: Supabase Dashboard → Project Settings → API → Project API Keys
# Use the `anon` public key for client-side, or `service_role` for server-side
SUPABASE_KEY=

# Google OAuth 2.0 Client ID
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URIs to your app's callback URL
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret
# Found alongside the Client ID in Google Cloud Console credentials
GOOGLE_CLIENT_SECRET=

# Admin Panel Password
# Set any strong password you want for accessing /admin
ADMIN_PASSWORD=your_secure_password_here
